{
  "name": "comprehensive_benchmark_fleet_marketplace_prod",
  "description": "Production-ready reduced benchmark focusing on stable high-performing variants.",
  "iterations": 1000,
  "trials": 3,
  "combination_mode": "cartesian",
  "hyperparameter_preset": "custom_balanced_constrained",
  "variants": {
    "adstock": [
      {
        "name": "geometric",
        "adstock": "geometric"
      }
    ],
    "train_splits": [
      {
        "name": "75_90",
        "train_size": [
          0.75,
          0.9
        ]
      }
    ],
    "time_aggregation": [
      {
        "name": "weekly",
        "resample_freq": "W"
      },
      {
        "name": "daily",
        "resample_freq": "none"
      }
    ],
    "spend_var_mapping": [
      {
        "name": "mixed_by_funnel_clicks",
        "description": "Upper funnel (FB) → impressions; search/other → spend. Column order matches paid_media_spends.",
        "mapping_strategy": "mixed",
        "paid_media_vars_override": [
          "GOOGLE_SEARCH_BRAND_COST",
          "GOOGLE_SEARCH_NONBRAND_COST_2",
          "GOOGLE_PMAX_COST_2",
          "GOOGLE_OTHER_COST_2",
          "BING_SEARCH_BRAND_COST",
          "BING_SEARCH_NONBRAND_COST",
          "BING_OTHER_COST",
          "FB_UPPER_IMPRESSIONS",
          "FB_LOWER_COST",
          "FB_APP_COST"
        ]
      },
      {
        "name": "spend_to_clicks",
        "description": "All channels: spend → clicks/impressions proxy. Column order matches paid_media_spends.",
        "mapping_strategy": "spend_to_proxy",
        "paid_media_vars_override": [
          "GOOGLE_SEARCH_BRAND_CLICKS",
          "GOOGLE_SEARCH_NONBRAND_CLICKS_2",
          "GOOGLE_PMAX_CLICKS_2",
          "GOOGLE_OTHER_IMPRESSIONS_2",
          "BING_SEARCH_BRAND_CLICKS",
          "BING_SEARCH_NONBRAND_CLICKS",
          "BING_OTHER_CLICKS",
          "FB_UPPER_IMPRESSIONS",
          "FB_LOWER_CLICKS",
          "FB_APP_CLICKS"
        ]
      }
    ]
  }
}